+
+package io.mosip.registration.liveness;
+
+import java.util.List;
+
+import io.mosip.registration.dto.packetmanager.BiometricsDto;
+
+/**
+ * The four seams a face liveness engine needs in the Registration Client (PRAMAAN, ADR 0003, patches P1 to P4).
+ *
+ * <p>The client calls these only for the FACE modality. With no implementation on the classpath the client behaves exactly
+ * as it did before: see {@link LivenessHooks#NONE}. An implementation is found with {@link java.util.ServiceLoader}.
+ */
+public interface LivenessHook {
+
+	/**
+	 * A face scan is starting (before the stream is read). Returns the SBI {@code transactionId} the client must send in
+	 * the rCapture request (P3), so the device signs it inside the capture, or {@code null} to keep the client's own.
+	 * SBI allows 4 to 50 characters of letters, digits and hyphens.
+	 */
+	String beginFaceScan(String modality);
+
+	/**
+	 * Every decoded preview frame (P2): the JPEG bytes and when they arrived. Called on the streamer thread, so it must
+	 * return quickly and must not throw; the preview never stops because of the hook.
+	 */
+	void onPreviewFrame(byte[] jpeg, long arrivedAtEpochMillis);
+
+	/**
+	 * Called on the capture thread (P1) before the client asks the device for the signed capture. Blocks until the engine
+	 * has reached its capture step, or throws to stop the scan. The client no longer requests the capture the moment the
+	 * stream opens.
+	 */
+	void awaitCaptureClearance() throws InterruptedException, LivenessRefusedException;
+
+	/**
+	 * Called with the device's signed capture before the client stores it (P4). Returns the signed liveness evidence (a
+	 * JWS) to put in the face BIR {@code others} map, or throws {@link LivenessRefusedException} if the capture is not
+	 * the face that passed liveness, in which case nothing is stored.
+	 */
+	String afterCapture(List<BiometricsDto> captured) throws LivenessRefusedException;
+}
diff --git a/registration/registration-services/src/main/java/io/mosip/registration/liveness/LivenessHooks.java b/registration/registration-services/src/main/java/io/mosip/registration/liveness/LivenessHooks.java
new file mode 100644
index 0000000..7ae44e9
--- /dev/null
+++ b/registration/registration-services/src/main/java/io/mosip/registration/liveness/LivenessHooks.java
@@ -0,0 +1,86 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+
+package io.mosip.registration.liveness;
+
+import java.util.Iterator;
+import java.util.List;
+import java.util.ServiceLoader;
+
+import io.mosip.registration.dto.packetmanager.BiometricsDto;
+
+/**
+ * Finds the {@link LivenessHook} implementation, if any, once. With none, {@link #NONE} does nothing, so the client is
+ * unchanged. If an implementation is present but cannot be loaded, the face scan is refused rather than run without
+ * liveness: a station that was meant to check liveness must not silently stop checking.
+ */
+public final class LivenessHooks {
+
+	/** Does nothing: no transaction id of its own, no frames kept, no wait, no evidence. */
+	public static final LivenessHook NONE = new LivenessHook() {
+		@Override
+		public String beginFaceScan(String modality) {
+			return null;
+		}
+
+		@Override
+		public void onPreviewFrame(byte[] jpeg, long arrivedAtEpochMillis) {
+			// nothing
+		}
+
+		@Override
+		public void awaitCaptureClearance() {
+			// nothing
+		}
+
+		@Override
+		public String afterCapture(List<BiometricsDto> captured) {
+			return null;
+		}
+	};
+
+	private static volatile LivenessHook hook;
+	private static volatile LivenessRefusedException loadFailure;
+
+	private LivenessHooks() {
+	}
+
+	/** The implementation, or {@link #NONE}. Throws if one is installed but failed to load (fail closed). */
+	public static LivenessHook get() throws LivenessRefusedException {
+		if (loadFailure != null) {
+			throw loadFailure;
+		}
+		LivenessHook h = hook;
+		if (h == null) {
+			synchronized (LivenessHooks.class) {
+				h = hook;
+				if (h == null) {
+					try {
+						Iterator<LivenessHook> it = ServiceLoader.load(LivenessHook.class).iterator();
+						h = it.hasNext() ? it.next() : NONE;
+					} catch (Throwable t) {
+						loadFailure = new LivenessRefusedException("a liveness hook is installed but did not load: " + t);
+						throw loadFailure;
+					}
+					hook = h;
+				}
+			}
+		}
+		return h;
+	}
+
+	/** For the preview thread: never throws, and never slows the preview when there is no hook. */
+	public static void frame(byte[] jpeg, long arrivedAtEpochMillis) {
+		try {
+			LivenessHook h = get();
+			if (h != NONE) {
+				h.onPreviewFrame(jpeg, arrivedAtEpochMillis);
+			}
+		} catch (Throwable t) {
+			// the preview must keep running; a hook that fails here fails the capture at the next seam
+		}
+	}
+}
diff --git a/registration/registration-services/src/main/java/io/mosip/registration/liveness/LivenessRefusedException.java b/registration/registration-services/src/main/java/io/mosip/registration/liveness/LivenessRefusedException.java
